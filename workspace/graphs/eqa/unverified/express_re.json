    {
      "id": "answer_stop_llm",
      "type": "llmCall",
      "label": "LLM: Answer (stop, answer.txt)",
      "position": {
        "x": 2240,
        "y": 120
      },
      "config": {
        "ports": [
          {
            "name": "question",
            "wire_type": "TEXT",
            "required": true
          },
          {
            "name": "rgb",
            "wire_type": "IMAGE",
            "required": true
          }
        ],
        "template": "You will be shown a picture that have been collected. Given a user query, you must output `text` to answer to the question asked by the user. No explanatory text is required.\nIf the query and the image do not provide enough information to properly answer, provide an appropriate guess. Avoid stating uncertainty about answering a question. Below are several examples.\nQ: What machine is on top of the stove?\nA: The microwave.\nExplanation: Stoves are typically found in kitchens and near microwaves.\n\nQ: What piece of furniture is in the middle of the bedroom?\nA: It is a bed.\nExplanation: Bedrooms almost always contain a bed.\n\nQ: Is the door open or closed?\nA: The door is open.\nExplanation: The door can be in either state, so we just randomly pick one.\n\nQ: Where is the coffee table in the living room? \nA: It is in front of the sofa.\nExplanation: If a coffee table is in the living room, it is usually positioned in front of the sofa.\nQ: {question}\nA: ",
        "system_prompt": "You are good at question answering. You will be asked questions about an indoor space and you must provide an answer.",
        "profile": "",
        "temperature": 1.0,
        "max_tokens": 2000,
        "mode": "single_turn"
      }
    },
    {
      "id": "answer_trunc_llm",
      "type": "llmCall",
      "label": "LLM: Answer (truncated, random_answer.txt, no image)",
      "position": {
        "x": 2240,
        "y": 320
      },
      "config": {
        "ports": [
          {
            "name": "question",
            "wire_type": "TEXT",
            "required": true
          }
        ],
        "template": "If the question does not provide enough information to properly answer, provide an appropriate guess. Avoid stating uncertainty about answering a question. No explanatory text is required.\n\nQ: What machine is on top of the stove?\nA: The microwave.\nExplanation: Stoves are typically found in kitchens and near microwaves.\n\nQ: What piece of furniture is in the middle of the bedroom?\nA: A bed.\nExplanation: Bedrooms almost always contain a bed.\n\nQ: Is the door open or closed?\nA: It is open.\nExplanation: The door can be in either state, so we just randomly pick one.\n{question}",
        "system_prompt": "You are an intelligent question answering agent. I will ask you questions about an indoor space and you must provide an answer.",
        "profile": "",
        "temperature": 1.0,
        "max_tokens": 2000,
        "mode": "single_turn"
      }
